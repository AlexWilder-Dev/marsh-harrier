# Turso database — https://turso.tech
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin dashboard password (plain text — hashed with SHA-256 at runtime)
ADMIN_PASSWORD=your-secure-password

# Formspree — https://formspree.io
# Used for the rooms/accommodation enquiry form
NEXT_PUBLIC_FORMSPREE_ID=your-formspree-form-id

# Formspree — general contact form (if separate from rooms enquiry)
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=your-formspree-contact-form-id

# Sanity CMS — https://sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=6vndcevs
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token
