# Turso database — https://turso.tech
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin dashboard password (plain text — hashed with SHA-256 at runtime)
ADMIN_PASSWORD=your-secure-password

# Formspree — https://formspree.io
# Both forms are submitted server-side (via /api/enquiry and /api/contact), so
# the IDs are read at runtime and do NOT need the NEXT_PUBLIC_ prefix. The
# NEXT_PUBLIC_ names below still work (the routes fall back to them), but the
# non-prefixed names are preferred because they can't be affected by the
# build-time inlining that silently broke the contact form before.

# Rooms / accommodation enquiry form
FORMSPREE_ID=your-formspree-form-id
# NEXT_PUBLIC_FORMSPREE_ID=your-formspree-form-id   # legacy fallback

# General contact / booking form (if separate from rooms enquiry).
# If left unset, /api/contact falls back to FORMSPREE_ID so messages still
# reach the pub rather than vanishing.
FORMSPREE_CONTACT_ID=your-formspree-contact-form-id
# NEXT_PUBLIC_FORMSPREE_CONTACT_ID=your-formspree-contact-form-id   # legacy fallback

# Sanity CMS — https://sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=6vndcevs
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token
